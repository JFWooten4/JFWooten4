{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node api/_generate-redirects.js && bundle exec jekyll build",
  "outputDirectory": "_site",
  "functions": {
    "api/redirect.js": {
      "includeFiles": "redirects/*.toml"
    }
  },
  "headers": [
    {
      "source": "/.well-known/stellar.toml",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/props/tf2/fannign.png",
      "destination": "/backgrounds/props/tf2/fanning.png",
      "permanent": true
    },
    {
      "source": "/props/:path*",
      "destination": "/backgrounds/props/:path*",
      "permanent": true
    },
    {
      "source": "/backgrounds/power-mountian.jpg",
      "destination": "/backgrounds/power-mountain.jpg",
      "permanent": true
    },
    {
      "source": "/banners/climbing-pheonix.PNG",
      "destination": "/banners/climbing-phoenix.PNG",
      "permanent": true
    },
    {
      "source": "/banners/decievingly-cute.png",
      "destination": "/banners/deceivingly-cute.png",
      "permanent": true
    },
    {
      "source": "/scam",
      "destination": "/btc",
      "permanent": true
    },
    {
      "source": "/scam/:path*",
      "destination": "/btc/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/codex",
      "destination": "/codex/index.html"
    },
    {
      "source": "/codex/:thread",
      "destination": "/codex/index.html"
    },
    {
      "source": "/friends/0",
      "destination": "/index.html"
    },
    {
      "source": "/friends/1",
      "destination": "/index.html"
    },
    {
      "source": "/friends/2",
      "destination": "/index.html"
    },
    {
      "source": "/friends/3",
      "destination": "/index.html"
    },
    {
      "source": "/book.pdf",
      "destination": "/static/book.pdf"
    },
    {
      "source": "/legal/:path*",
      "destination": "/static/legal/:path*"
    },
    {
      "source": "/src/:path*",
      "destination": "/static/src/:path*"
    },
    {
      "source": "/tax",
      "destination": "/static/tax/index.html"
    },
    {
      "source": "/tax/:path*",
      "destination": "/static/tax/:path*"
    },
    {
      "source": "/btc",
      "destination": "/static/btc/index.html"
    },
    {
      "source": "/btc/:path*",
      "destination": "/static/btc/:path*"
    },
    {
      "source": "/ppt",
      "destination": "/static/ppt/index.html"
    },
    {
      "source": "/ppt/:path*",
      "destination": "/static/ppt/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/redirect"
    }
  ]
}
