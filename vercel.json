{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node api/_generate-redirects.js && bundle exec ruby api/_publish-static.rb",
  "outputDirectory": "_site",
  "functions": {
    "api/redirect.js": {
      "includeFiles": "redirects/*.toml"
    }
  },
  "headers": [
    {
      "source": "/search-index.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/stellar.toml",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/scam",
      "destination": "/btc",
      "permanent": true
    },
    {
      "source": "/scam/:path*",
      "destination": "/btc/:path*",
      "permanent": true
    },
    {
      "source": "/legal/:path*",
      "destination": "/law/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/codex",
      "destination": "/codex/index.html"
    },
    {
      "source": "/codex/:thread",
      "destination": "/codex/index.html"
    },
    {
      "source": "/friends/0",
      "destination": "/index.html"
    },
    {
      "source": "/friends/1",
      "destination": "/index.html"
    },
    {
      "source": "/friends/2",
      "destination": "/index.html"
    },
    {
      "source": "/friends/3",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/api/redirect"
    }
  ]
}
