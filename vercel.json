{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node api/_generate-redirects.js && bundle exec ruby api/_publish-static.rb",
  "outputDirectory": "_site",
  "functions": {
    "api/redirect.js": {
      "includeFiles": "redirects/*.toml"
    }
  },
  "headers": [
    {
      "source": "/search-index.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/stellar.toml",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/codex/:thread*",
      "destination": "/codex/index.html"
    },
    {
      "source": "/friends/:index([0-9]+)",
      "destination": "/index.html"
    },
    {
      "source": "/redirect-editor",
      "destination": "/api/redirect-edit"
    },
    {
      "source": "/:path*",
      "destination": "/api/redirect"
    }
  ]
}
