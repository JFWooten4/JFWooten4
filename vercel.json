{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bundle exec jekyll build",
  "outputDirectory": "_site",
  "functions": {
    "api/redirect.js": {
      "includeFiles": "{404.html,var/law.toml}"
    }
  },
  "headers": [
    {
      "source": "/.well-known/stellar.toml",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/static/book/1879%20-%20The%20Law%20of%20Money%20Securities%20-%20Christopher%20Cavanagh.pdf",
      "destination": "/static/book/law-of-money-securities.pdf",
      "permanent": true
    },
    {
      "source": "/static/book/Railroad%20Capitalization%20-%20James%20Cummings%20Bonbright%20-%201920.pdf",
      "destination": "/static/book/railroad-capitalization.pdf",
      "permanent": true
    },
    {
      "source": "/static/book/Short%20Term%20Securities%20-%20Guaranty%20Trust%20Company%20of%20New%20York%20-%201918.pdf",
      "destination": "/static/book/short-term-securities.pdf",
      "permanent": true
    },
    {
      "source": "/scam",
      "destination": "/btc",
      "permanent": true
    },
    {
      "source": "/scam/:path*",
      "destination": "/btc/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/friends/0",
      "destination": "/index.html"
    },
    {
      "source": "/friends/1",
      "destination": "/index.html"
    },
    {
      "source": "/friends/2",
      "destination": "/index.html"
    },
    {
      "source": "/friends/3",
      "destination": "/index.html"
    },
    {
      "source": "/book.pdf",
      "destination": "/static/book.pdf"
    },
    {
      "source": "/legal/:path*",
      "destination": "/static/legal/:path*"
    },
    {
      "source": "/src/:path*",
      "destination": "/static/src/:path*"
    },
    {
      "source": "/tax",
      "destination": "/static/tax/index.html"
    },
    {
      "source": "/tax/:path*",
      "destination": "/static/tax/:path*"
    },
    {
      "source": "/btc",
      "destination": "/static/btc/index.html"
    },
    {
      "source": "/btc/:path*",
      "destination": "/static/btc/:path*"
    },
    {
      "source": "/ppt",
      "destination": "/static/ppt/index.html"
    },
    {
      "source": "/ppt/:path*",
      "destination": "/static/ppt/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/redirect"
    }
  ]
}
